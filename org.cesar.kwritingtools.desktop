[Desktop Entry]
Name=Herramientas de Escritura
Name[es]=Herramientas de Escritura
GenericName=Apple Intelligence Writing Tools
GenericName[es]=Herramientas de Escritura IA
Comment=Asistente de redacción y corrección estilo Apple Intelligence con Ollama local
Comment[es]=Asistente de redacción y corrección estilo Apple Intelligence con Ollama local
Exec=kwritingtools
Icon=document-edit-symbolic
Type=Application
Categories=Qt;KDE;Utility;TextEditor;Office;
StartupNotify=true
Terminal=false
Actions=Proofread;Rewrite;

[Desktop Action Proofread]
Name=Corregir ortografía y gramática
Exec=kwritingtools --proofread
Icon=edit-find-replace

[Desktop Action Rewrite]
Name=Reescribir selección
Exec=kwritingtools --rewrite
Icon=document-edit-symbolic
